#!/bin/sh
set -euf

## https://github.com/sixarm/unix-shell-script-kit

failures=0
err() { failures=$((failures + 1)); >&2 printf %s\\n "Error: ${*}"; }

directory_exists_or_err() { test -d "$1" || err "Directory should exist: $1"; }
file_exists_or_err() { test -f "$1" || err "File should exist: $1"; }
file_size_or_err() { file_exists_or_err "$1" && test -s "$1" || err "File should have content: $1"; }
symlink_exists_or_err() { test -h "$1" || err "Symlink should exist: $1"; }
symlink_target_or_err() {
    actual="$(readlink "$1" 2>/dev/null || true)"
    test "$actual" = "$2" || err "Symlink $1 should point to $2, found: ${actual:-<none>}"
}

## main

top="$(git rev-parse --show-toplevel)"
locales="en-gb-oxendict en-001 en-gb en-us cy-001 cy-gb zh-cn es-001 es-es hi-001 hi-in ar-001 ar-eg fr-001 fr-fr pt-001 pt-pt de-de de-001 ru-001 ru-ru bn-bd ko-kr ja-jp sv-se nl-nl ur-pk id-id it-it uk-ua fi-fi no-no da-dk pl-pl vi-001 et-001 th-001 tr-tr"
topics="patient-portal-adoption-rate telehealth-visit-rate appointment-no-show-rate clinical-alert-override-rate digital-referral-turnaround-time"

## A locale's topics directory name is translated per locale (en-* keep
## `topics`; es-es uses `temas`, etc.), and so is each topic's slug. The one
## stable identity is the topic's .locale-peer-id, so look topics up by it.
topics_dir_for() {
    if test -d "$top/locales/$1/topics"; then
        echo "$top/locales/$1/topics"
        return
    fi
    find "$top/locales/$1" -mindepth 1 -maxdepth 1 -type d | head -n 1
}

topic_dir_for() {
    locale="$1"; topic="$2"
    peer="$(cat "$top/locales/en-gb-oxendict/topics/$topic/.locale-peer-id")"
    find "$(topics_dir_for "$locale")" -mindepth 1 -maxdepth 1 -type d | while read -r d; do
        if test -f "$d/.locale-peer-id" && test "$(cat "$d/.locale-peer-id")" = "$peer"; then
            echo "$d"
        fi
    done | head -n 1
}

test_locale_has_one_topics_dir() {
    for locale in $locales; do
        case "$locale" in en-*) continue ;; esac
        count="$(find "$top/locales/$locale" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')"
        test "$count" = 1 || err "locales/$locale should have exactly one (translated) topics directory, found $count"
    done
}

test_locales_exist() {
    for locale in $locales; do
        directory_exists_or_err "$top/locales/$locale"
    done
}

test_locale_root_files() {
    for locale in $locales; do
        dir="$top/locales/$locale"
        file_size_or_err "$dir/.locale-peer-id"
        file_size_or_err "$dir/index.md"
        symlink_exists_or_err "$dir/README.md"
        symlink_target_or_err "$dir/README.md" "index.md"
    done
}

test_topic_files() {
    for locale in $locales; do
        for topic in $topics; do
            dir="$(topic_dir_for "$locale" "$topic")"
            test -n "$dir" || { err "Topic $topic has no directory in locale $locale"; continue; }
            file_size_or_err "$dir/.locale-peer-id"
            file_size_or_err "$dir/index.md"
            symlink_exists_or_err "$dir/README.md"
            symlink_target_or_err "$dir/README.md" "index.md"
        done
    done
}

## Every locale's version of "the same" topic must carry a byte-identical
## .locale-peer-id, regardless of slug — that identity, not the slug, is how
## the site resolves "this page, in locale X" (see
## spec/locales-for-global-sharing-with-svelte/index.md).
test_peer_id_parity() {
    for locale in $locales; do
        for d in $(find "$(topics_dir_for "$locale")" -mindepth 1 -maxdepth 1 -type d | sed 's/ /%20/g'); do
            d="$(printf %s "$d" | sed 's/%20/ /g')"
            id="$(cat "$d/.locale-peer-id" 2>/dev/null || true)"
            test -n "$id" || { err "Missing peer id: $d"; continue; }
            find "$top/locales/en-gb-oxendict/topics" -name .locale-peer-id | xargs grep -lx "$id" >/dev/null 2>&1 \
                || err "Peer id $id in $d matches no canonical topic"
        done
    done
}

## en-001, en-gb, and en-us are derived from en-gb-oxendict by
## tools/localize.py and must never be hand-edited out of sync with it.
test_localize_up_to_date() {
    snapshot="$(mktemp -d)"
    trap 'rm -rf "$snapshot"' EXIT
    cp -R "$top/locales/en-001" "$top/locales/en-gb" "$top/locales/en-us" "$snapshot/"
    (cd "$top" && python3 tools/localize.py >/dev/null)
    for locale in en-001 en-gb en-us; do
        diff -r "$snapshot/$locale" "$top/locales/$locale" >/dev/null \
            || err "locales/$locale is out of date: rerun tools/localize.py and commit the result"
    done
    rm -rf "$snapshot"
    trap - EXIT
}

main() {
    test_locales_exist
    test_locale_root_files
    test_locale_has_one_topics_dir
    test_topic_files
    test_peer_id_parity
    test_localize_up_to_date
    if [ "$failures" -ne 0 ]; then
        err "$failures check(s) failed"
        exit 1
    fi
    echo "All checks passed."
}

main
